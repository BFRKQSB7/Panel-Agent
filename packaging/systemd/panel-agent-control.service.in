# Generated by panel-agent-installer; replace @...@ values and preserve the ownership marker.
# Managed by Panel-Agent; ownership is recorded in ownership.json.
[Unit]
Description=Panel-Agent control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@CONTROL_DATA@
ExecStart="@CONTROL_BIN@" serve --data-dir "@CONTROL_DATA@" --listen "@CONTROL_LISTEN@"
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=@CONTROL_DATA@ @LOG_ROOT@
StandardOutput=append:@CONTROL_LOG@
StandardError=append:@CONTROL_LOG@
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200

[Install]
WantedBy=multi-user.target
