# Generated by panel-agent-installer; replace @...@ values and preserve the ownership marker.
# Managed by Panel-Agent; ownership is recorded in ownership.json.
[Unit]
Description=Panel-Agent edge agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@AGENT_DATA@
ExecStart="@AGENT_BIN@" run --data-dir "@AGENT_DATA@" --xray-path "@XRAY_BIN@"
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=@AGENT_DATA@ @LOG_ROOT@
StandardOutput=append:@AGENT_LOG@
StandardError=append:@AGENT_LOG@
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200

[Install]
WantedBy=multi-user.target
