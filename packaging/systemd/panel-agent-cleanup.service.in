# Generated by panel-agent-installer; replace @...@ values.
# Managed by Panel-Agent; ownership is recorded in ownership.json.
[Unit]
Description=Panel-Agent role cleanup
After=@SERVICE_NAME@.service

[Service]
Type=oneshot
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
ExecStart="@ROLE_BIN@" cleanup --data-dir "@ROLE_DATA@" --log-root "@LOG_ROOT@"
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=@ROLE_DATA@ @LOG_ROOT@
StandardOutput=append:@ROLE_LOG@
StandardError=append:@ROLE_LOG@
